# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas or an approved MongoDB deployment
MONGODB_URI=""

# Session signing secret: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# SMTP server used to email OTP codes (465 = implicit TLS, 587 = STARTTLS)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
OTP_EMAIL_FROM=""

# Cloudinary file storage (server-side only; the API secret is never sent to the browser)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Maximum size of each uploaded file, in MB
MAX_FILE_SIZE_MB="10"

# Optional: institutional timezone for business dates and display (default: Asia/Kolkata)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Seed script (npm run seed): the initial administrator. Signs in with OTP; no password.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="System Administrator"

# Optional: per-client-IP limits for sign-in endpoints, per 15 minutes (defaults 100 / 300).
# Kept high because staff may share one campus NAT IP; per-email OTP limits remain the primary control.
AUTH_REQUEST_OTP_IP_LIMIT=""
AUTH_VERIFY_OTP_IP_LIMIT=""

# Optional master OTP: a fixed 6-digit code accepted instead of the emailed code for registered, active users.
# Leave empty to disable. Ignored in production unless MASTER_OTP_ALLOW_IN_PRODUCTION="true".
# Wrong guesses count toward the normal 5-attempt limit; each use is logged (without the code).
MASTER_OTP=""
MASTER_OTP_ALLOW_IN_PRODUCTION=""

# Optional: root Cloudinary folder for uploads (default: office-daily-updates).
# Files are stored as <folder>/<officeId>/<photos|documents>.
CLOUDINARY_UPLOAD_FOLDER=""
